:- import storage_insert_fact/3, storage_insert_fact_bt/3,
          storage_delete_fact/3, storage_delete_fact_bt/3,
          storage_find_fact/2, storage_reclaim_space/1 from storage.

test :-
    % Multiple passes also exercise reuse of the reclaimed trie nodes.
    cycles(10),
    writeln('repeated disposal and reclamation passed').

cycles(0) :- !.
cycles(N) :-
    churn(12),
    % Revive a leaf while old disposal records still reference it.
    storage_insert_fact(reclaim_test,f(1),1),
    % Undo a deletion after another leaf has been queued for reclamation.
    (storage_delete_fact_bt(reclaim_test,f(1),1),
     storage_insert_fact(reclaim_test,f(2),1),
     storage_delete_fact(reclaim_test,f(2),1),
     fail
    ; true),
    storage_reclaim_space(reclaim_test),
    findall(X,storage_find_fact(reclaim_test,f(X)),[1]),
    storage_reclaim_space(reclaim_test),
    storage_delete_fact(reclaim_test,f(1),1),
    storage_reclaim_space(reclaim_test),
    \+ storage_find_fact(reclaim_test,_),
    % The empty reclamation pass must also be harmless.
    storage_reclaim_space(reclaim_test),
    N1 is N-1,
    cycles(N1).

churn(0) :- !.
churn(N) :-
    % Enough siblings to exercise hashed as well as shared trie branches.
    insert_then_backtrack(40),
    N1 is N-1,
    churn(N1).

insert_then_backtrack(0) :- !.
insert_then_backtrack(N) :-
    (storage_insert_fact_bt(reclaim_test,f(N),1), fail ; true),
    N1 is N-1,
    insert_then_backtrack(N1).
