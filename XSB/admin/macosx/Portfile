# Local release-test Portfile. build_package.sh fills in the distfile location
# and checksum; the committed file is not an upstream MacPorts submission.
PortSystem          1.0

name                xsb
version             5.1.0
revision            0
categories          lang
license             LGPL-2+
maintainers         nomaintainer
description         XSB logic programming and deductive database system
long_description    XSB is a logic programming and deductive database system.
homepage            https://xsb.sourceforge.net/

master_sites        file://@DISTDIR@/
distfiles           xsb-${version}.tar.gz
checksums           sha256 @SHA256@
worksrcdir          XSB

depends_lib         port:python312 \
                    port:py312-pip \
                    port:py312-setuptools \
                    port:py312-wheel \
                    port:py312-build \
                    port:pcre \
                    port:libxml2 \
                    port:curl

# The generated XSB and Janus files contain absolute paths. Stage sources,
# then configure and build at the final location after activation.
use_configure       no
build               {}

destroot {
    set installed_xsb ${destroot}${prefix}/share/xsb-${version}
    xinstall -d ${installed_xsb}
    system "cp -R ${worksrcpath}/. ${installed_xsb}/"
    xinstall -d ${destroot}${prefix}/bin
    ln -sf ../share/xsb-${version}/bin/xsb ${destroot}${prefix}/bin/xsb
}

post-activate {
    system "sh ${prefix}/share/xsb-${version}/admin/macosx/install_in_place.sh ${prefix}/share/xsb-${version} ${prefix}/bin/python3.12"
}

package.flat        no

post-pkg {
    set resources ${workpath}/${name}-${version}.pkg/Contents/Resources
    file copy -force -- ${worksrcpath}/admin/macosx/postflight-template ${resources}/postflight
    reinplace "s|@PREFIX@|${prefix}|g" ${resources}/postflight
    reinplace "s|@VERSION@|${version}|g" ${resources}/postflight
    file attributes ${resources}/postflight -permissions 0755
}
