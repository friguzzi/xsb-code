% prism optimization

:- import length/2,append/3,nth/3 from lists.
:- import concat_atom/2 from string.
:- import check_ground/3 from error_handler.
:- export
prob/2, 
load/1,load_file/1,
parse/2.
:- dynamic v/3.
:-dynamic '$p'/2,setting/2.

:- set_prolog_flag(unknown,fail).

setting(epsilon_parsing, 0.0001).
%:-yap_flag(unknown,fail).
setting(compiling,false).
/* compiling: true, failse */
setting(tabling_output,video).
/* video, call */


myor(A,B,C):-C is A+B.
myand(A,B,C):-C is A*B.
myret_prob(B,B).
myzero(0.0).
myone(1.0).
mybdd_not(A,B):-B is 1-A.
	
myinit(M):-
	retractall(M:v(_,_,_,_)),
	abolish_all_tables.

prob(M:Goal,P):-
	myinit(M),
	add_bdd_arg(Goal,BDD,Goal1),
	(call((M:Goal1))->
		myret_prob(BDD,P)
	;
		P=0.0
	).



prob(M:Goal,P,CPUTime1,WallTime1):-
        cputime(CT0),
	walltime(WT0),
	myinit(M),
	add_bdd_arg(Goal,BDD,Goal1),
	(call(M:Goal1)->
		myret_prob(BDD,P)
	;
		P=0.0
	),
	cputime(CT1),
	CPUTime1 is CT1-CT0,
	walltime(WT1),
	WallTime1 is WT1-WT0.


s(M:Goal,P):-
        prob(M:Goal,P).

s(M:Goal,P,CPUTime1,0,WallTime1,0):-
        prob(M:Goal,P,CPUTime1,WallTime1).

load(File):-
  concat_atom([FileNoExt,'.',_], File),
	concat_atom([FileNoExt,'.P'],FileP),
	parse(File,FileP),
  consult(FileP).



