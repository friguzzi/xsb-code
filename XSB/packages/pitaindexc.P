list2and([X], X) :-
        X\= (_, _) , !.

list2and([H|T], (H, Ta)) :- !,
	list2and(T, Ta).



list2or([X], X) :-
	X \= ( _ ; _ ) , !.

list2or([H|T], (H ; Ta)) :- !,
	list2or(T, Ta).

get_var_n(R,S,Probs,V):-
	(v(R,S,V,Probs)->
		true
	;	
		get_next_var_number(V),
		assert(v(R,S,V,Probs))
	).

generate_rules_fact([],[]).

generate_rules_fact([(Head:P),('':_P2)],[Head1]):-!,
	add_bdd_arg(Head,P,Head1).

generate_rules_fact([(Head:P)|T],[Head1|Clauses]):-
	add_bdd_arg(Head,P,Head1),
	generate_rules_fact(T,Clauses).

generate_clause(Head,Body,P,BDDAnd,Clause):-
	add_bdd_arg(Head,BDD,Head1),
	Clause=(Head1:-(Body,myand(BDDAnd,P,BDD))).

generate_rules([],_Body,_BDDAnd,[]).

generate_rules([(Head:P),('':_P2)],Body,BDDAnd,[Clause]):-!,
	generate_clause(Head,Body,P,BDDAnd,Clause).

generate_rules([(Head:P)|T],Body,BDDAnd,[Clause|Clauses]):-
	generate_clause(Head,Body,P,BDDAnd,Clause),
	generate_rules(T,Body,BDDAnd,Clauses).


process_body([],BDD,BDD,[]).

process_body([\+ H|T],BDD,BDD1,[\+ H|Rest]):-
	builtin(H),!,
	process_body(T,BDD,BDD1,Rest).

process_body([\+ H|T],BDD,BDD1,
	[(H1->mybdd_not(BDDH,BDDN);myone(BDDN)),myand(BDD,BDDN,BDD2)|Rest]):-!,
	add_bdd_arg(H,BDDH,H1),
	process_body(T,BDD2,BDD1,Rest).

process_body([H|T],BDD,BDD1,[H|Rest]):-
	builtin(H),!,
	process_body(T,BDD,BDD1,Rest).

process_body([H|T],BDD,BDD1,
	[H1,myand(BDD,BDDH,BDD2)|Rest]):-!,
	add_bdd_arg(H,BDDH,H1),
	process_body(T,BDD2,BDD1,Rest).



and_list([],B,B).
and_list([H|T],B0,B1):-
	and(B0,H,B2),
	and_list(T,B2,B1).


/* set(Par,Value) can be used to set the value of a parameter */
set(Parameter,Value):-
	retract(setting(Parameter,_)),
	assert(setting(Parameter,Value)).




difference([],_,[]).

difference([H|T],L2,L3):-
	member_eq(H,L2),!,
	difference(T,L2,L3).
	
difference([H|T],L2,[H|L3]):-
	difference(T,L2,L3).
	
add_bdd_arg(A,BDD,A1):-
	A=..[P|Args],
	append(Args,[BDD],Args1),
	A1=..[P|Args1],
	functor(A1,_,Arity),
	('$p'(P,Arity)->
		true
	;
		assert('$p'(P,Arity))
	).


table_pred(A):-	
	functor(A,P,Arity),
	Arity1 is Arity +1,
	functor(A1,P,Arity1),
	A1=..[_|Args],
	last(Args,lattice(myor/3)),
	(setting(tabling_output,call)->
		call(table(A1))
	;
		write((:- table A1)),
		writeln('.')
	).
last([H],H):-!.

last([_H|T],L):-
	last(T,L).

process_head(HeadList, GroundHeadList) :- 
	ground_prob(HeadList), !,
	process_head_ground(HeadList, 0, GroundHeadList).
	 
process_head(HeadList, HeadList).



/* process_head_ground([Head:ProbHead], Prob, [Head:ProbHead|Null])
 * ----------------------------------------------------------------
 */
process_head_ground([Head:ProbHead], Prob, [Head:ProbHead|Null]) :-!,
	ProbLast is 1 - Prob - ProbHead,
	setting(epsilon_parsing, Eps), 
	EpsNeg is - Eps, 
	ProbLast > EpsNeg, 
	(ProbLast > Eps ->
		Null = ['':ProbLast];
		Null = []). 

process_head_ground([Head:ProbHead|Tail], Prob, [Head:ProbHead|Next]) :- 
	ProbNext is Prob + ProbHead, 
	process_head_ground(Tail, ProbNext, Next).

ground_prob([]).

ground_prob([_Head:ProbHead|Tail]) :- 
	check_ground(ProbHead,_,_), % Succeeds if there are no free variables in the term ProbHead.
	ground_prob(Tail).



builtin(_A is _B).
builtin(_A > _B).
builtin(_A < _B).
builtin(_A >= _B).
builtin(_A =< _B).
builtin(_A =:= _B).
builtin(_A =\= _B).
builtin(true).
builtin(false).
builtin(_A = _B).
builtin(_A==_B).
builtin(_A\=_B).
builtin(_A\==_B).
builtin(length(_L, _N)).
builtin(member(_El, _L)).
builtin(average(_L, _Av)).
builtin(max_list(_L, _Max)).
builtin(min_list(_L, _Max)).
builtin(nth0(_, _, _)).
builtin(nth(_, _, _)).
builtin(eraseall(_Id)).
builtin(recordzifnot(_Id, _Item, _)).

parse(FileIn,FileOut):-
	retractall('$p'(_,_)),
	open(FileIn,read,SI),
	read_clauses(SI,C),
	close(SI),
        set(compiling,true),
	process_clauses(C,[],C1),
        set(compiling,false),
	open(FileOut,write,SO),
        findall(p(P,A),'$p'(P,A),L),
	write_export(L,SO),
  write_clauses([
		(:- export prob / 2),
		(:- import append/3 from lists),
		(myor(AA,BB,CC):- CC is AA+BB),
		(myand(AA,BB,CC):- CC is AA*BB),
		(myret_prob(BB,BB)),
		(myone(AA):- AA is 1.0),
		(myzero(AA):- AA is 0.0),
		(mybdd_not(A,B):- B is 1-A),
		(myinit :-
	    retractall(v(_,_,_,_)),
	    abolish_all_tables
		),
		(prob(Goal,P):-
			myinit,
			add_bdd_arg(Goal,BDD,Goal1),
			(call(Goal1)->
				myret_prob(BDD,P)
			;
				P=0.0
			)
		),
		(get_var_n(R,S,Probs,V):-
			(v(R,S,V,Probs)->
				true
			;	
				get_next_var_number(V),
				assert(v(R,S,V,Probs))
			)
		),
		(add_bdd_arg(A,BDD,A1):-
			A=..[P|Args],
			append(Args,[BDD],Args1),
			A1=..[P|Args1]
		)
    ],SO),
	write_tab_dir(L,SO),
	write_clauses(C1,SO),
	close(SO).




write_export([],_).

write_export([p(P,A)|T],SO):-
  write(SO,(:- export P/A)),
	writeln(SO,'.'),
	write_export(T,SO).

process_clauses([end_of_file],C,C).

process_clauses([H|T],C0,C1):-
	(term_expansion(H,H1)->
		true
	;
		H1=H
	),
	((H1=[_|_];H1=[])->
		append(C0,H1,C2)
	;
		append(C0,[H1],C2)
	),
	process_clauses(T,C2,C1).

read_clauses(S,[Cl|Out]):-
        read_term(S,Cl,[]),
	(Cl=end_of_file->
		Out=[]
	;
		read_clauses(S,Out)
	).

write_tab_dir([],S):-
        nl(S).

write_tab_dir([p(P,A)|T],S):-
        table_dir(P,A,Atom),
        write(S,':-table '),
        write(S,Atom),
        write(S,'.'),
        nl(S),
        write_tab_dir(T,S).

table_dir(P,Arity,Atom):-
        functor(Atom,P,Arity),
        Atom=..[_|Args],
        last(Args,lattice(myor/3)).

write_clauses([],_).

write_clauses([H|T],S):-
	write(S,H),
	write(S,'.'),
	nl(S),
	write_clauses(T,S).


term_expansion((:- pita), []) :-!.

term_expansion((:- begin_plp), []) :-!.

term_expansion((:- end_plp), []) :-!.

term_expansion((:- begin_lpad), []) :-!.

term_expansion((:- end_lpad), []) :-!.

term_expansion((:- use_module(_)), []) :-!.

term_expansion((:- endif), []) :-!.

term_expansion((:- if(_)), []) :-!.

term_expansion((:- use_rendering(_)), []) :-!.

term_expansion((:- use_rendering(_, _)), []) :-!.


term_expansion((Head :- Body), Clauses):-
% disjunctive clause with more than one head atom
	setting(compiling,true),
	Head = (_;_), !, 
	list2or(HeadListOr, Head), 
	process_head(HeadListOr, HeadList), 
	list2and(BodyList, Body), 
	process_body(BodyList,One,BDDAnd,BodyList1),
	list2and(BodyList1,Body1),
	generate_rules(HeadList,(myone(One),Body1),BDDAnd,Clauses).

term_expansion((Head :- Body), Clauses) :- 
% disjunctive clause with a single head atom
	setting(compiling,true),
	((Head:-Body) \= ((user:term_expansion(_,_) ):- _ )),
	Head = (H:P), !, 
	list2and(BodyList, Body), 
	process_body(BodyList,One,BDDAnd,BodyList2),
	list2and(BodyList2,Body2),
	generate_clause(H,(myone(One),Body2),P,BDDAnd,Clauses).


term_expansion((Head :- Body),Clauses) :- 
% definite clause
	setting(compiling,true),
	((Head:-Body) \= ((user:term_expansion(_,_)) :- _ )),!,
	list2and(BodyList, Body), 
	process_body(BodyList,One,BDDAnd,BodyList2),
	list2and(BodyList2,Body2),
	add_bdd_arg(Head,BDDAnd,Head1),
	Clauses=(Head1 :- (myone(One),Body2)).
	

term_expansion(Head,Clauses) :- 
% disjunctive fact with more than one head atom
	setting(compiling,true),
	Head = (_;_),!, 
	list2or(HeadListOr, Head), 
	process_head(HeadListOr, HeadList), 
	generate_rules_fact(HeadList,Clauses).

term_expansion(Head,Clause) :- 
% disjunctive fact with a single head atom
	setting(compiling,true),
	(Head \= ((term_expansion(_,_)) :- _ )),
	Head = (H:P), !, 
	add_bdd_arg(H,P,Head1),
	Clause=Head1.

term_expansion(Head, (Head1:-myone(One))) :- 
% definite fact
	setting(compiling,true),
	(Head \= ((term_expansion(_,_) ):- _ )),
	Head \= (:- table _ ),
	Head \= (:- import _),
	(Head\= end_of_file),!,
	add_bdd_arg(Head,One,Head1).

