%---------

py_dot(Obj,MethAttr,Ret):-
    py_dot_int(Obj,MethAttr,0,Ret).

py_dot(Obj,MethAttr,Ret,Opts):-
    janus_opts(Opts,Sizecheck_flag),
    py_dot_int(Obj,MethAttr,Sizecheck_flag,Ret).

janus_opts([],_,0).
janus_opts([sizecheck(true)],In,Out):- !, Out is In \/ 1.
janus_opts([sizecheck(false)],In,In):- !.
janus_opts([pyObject(true)],In,Out):- !,Out is In \/ 2.
janus_opts(Opts,_):- abort(Opts).

:- import term_psc/2, psc_arity/2, term_arg/3 from machine.

get_def_vars(Call,PosArgNbr,Dict):-
    check_callable(Call,'pyfunc/[3,4]',2),
    term_psc(Call, PSC),  
    psc_arity(PSC, Arity),
    get_def_vars_1(Arity,Call,PosArgNbr,VL),
    (VL= [] -> Dict = 0 ; def_vars_to_dict(VL,Dict)).

get_def_vars_1(0,_,0,[]):-!.
get_def_vars_1(ArgNbr,Call,PosArgNbr,VarList):-
%    writeln(get_def_vars_1(Call,ArgNbr,PosArgNbr,VarList)),
    term_arg(Call,ArgNbr,Arg),
    (Arg = =(A,B) ->
	 VarList = [A=B|VL1],
	 ArgNbr1 is ArgNbr-1,
	 get_def_vars_1(ArgNbr1,Call,PosArgNbr,VL1)
    ;    VarList = [],PosArgNbr = ArgNbr).

def_vars_to_dict(X,{}(Y)):-
    def_vars_to_dict_1(X,Y).
%
def_vars_to_dict_1([A=B],A:B):- !.
def_vars_to_dict_1([A=B|T],','(A:B,T1)):-
    def_vars_to_dict_1(T,T1).
